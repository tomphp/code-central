{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "code-central ping",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "code-central hook session-id",
            "type": "command"
          }
        ],
        "matcher": "mcp__code-central__claim|mcp__code-central__set_session|mcp__code-central__post_round"
      },
      {
        "hooks": [
          {
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/narrow-reads.py",
            "type": "command"
          },
          {
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prefer-edit.py",
            "type": "command"
          }
        ],
        "matcher": "Bash|Read"
      }
    ]
  }
}
